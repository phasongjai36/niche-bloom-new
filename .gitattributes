# Auto-detect text files and normalize line endings
* text=auto

# Source code — enforce LF
*.js        text eol=lf
*.cjs       text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.svg       text

# Shell scripts
*.sh        text eol=lf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Git attributes
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary assets
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.db        binary
*.sqlite    binary
*.sqlite3   binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
